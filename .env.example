# --- Pix (chave própria, sem provedor de pagamento) ---
PIX_KEY=sua-chave-pix-aqui
MERCHANT_NAME=FULANO DE TAL
MERCHANT_CITY=CIDADOPOLIS

# --- Envio do e-mail de aviso de pagamento (com o link "Imprimir") ---
# SMTP_USER/NOTIFY_TO servem pra mais uma coisa: é de um deles que sai o
# e-mail de contato no User-Agent das consultas de preço (ver identidade.py).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha-de-app-do-gmail
NOTIFY_TO=seuemail@gmail.com

# URL pública do backend — usada pra montar o link "Imprimir" do e-mail.
# Tem que ser um endereço alcançável de fora da LAN, do celular (o domínio
# do Cloudflare Tunnel, por exemplo). Sem barra no final.
PUBLIC_BASE_URL=https://forja.seudominio.com

# Endereço do backend na REDE LOCAL, ex.: http://192.168.3.47:8000. Vazio
# desliga o link extra. Sem barra no final.
#
# Serve pra abrir o PDF de dentro de casa sem passar pelo túnel. O link
# público sai daqui, sobe até a Cloudflare e volta — ou seja, gasta a subida
# do homelab duas vezes pra chegar numa máquina que está do lado, e num
# pedido grande isso são centenas de MB. Este link vai direto no IP: mesma
# folha, mesmo token assinado, sem a volta. Ele aparece no e-mail de aviso e
# na tela do admin, ao lado do "Ver PDF" normal.
LOCAL_BASE_URL=http://192.168.1.10:8000

# --- Guias de corte no PDF (opcional, tem padrão bom) ---
# Comprimento de cada marca em mm. 0 = estende a linha da divisa até a borda
# do papel (melhor pra cortar a folha inteira de uma vez na régua/refile).
# Use 5 pra marca curta só nos cantos, estilo gráfica.
GUIDE_LENGTH_MM=0
GUIDE_THICKNESS_MM=0.2
GUIDE_GRAY=0
# Cruz-guia verde em cada canto de carta, por cima da arte, marcando o ponto
# exato onde os dois cortes se encontram.
CORNER_CROSSES=1
CROSS_COLOR=#8aff0c
CROSS_ARM_MM=3
CROSS_THICKNESS_MM=0.2
# 1 volta a desenhar a moldura em volta de cada carta (sai tinta na borda da
# arte — cortando nela sobra um fiapo preto). Deixe 0.
CARD_OUTLINE=0

# --- Legenda da folha combinada (opcional, tem padrão bom) ---
# Numa folha combinada as 9 cartas podem ser de clientes diferentes. A legenda
# é uma linha de texto miúdo na margem de BAIXO — na tira que o refile joga
# fora — dizendo qual pedido ocupa quais posições daquela folha. Sem ela,
# separar a pilha depois do corte é adivinhação. 0 desliga.
COMBO_LABEL=1
COMBO_LABEL_PT=5.5
COMBO_LABEL_GRAY=0.45
COMBO_LABEL_Y_MM=4
# Quantas letras do nome do cliente cabem na legenda antes de virar ponto.
COMBO_LABEL_NOME=16

# --- Impressora de rede (CUPS) ---
# CUPS_HOST vazio = fala pelo socket local (quando o container roda na mesma
# máquina do cupsd e monta /run/cups/cups.sock). PRINTER_QUEUE vazia desliga
# a impressão automática — o pedido só é confirmado, e a impressão fica
# manual, pelo link "Ver PDF".
CUPS_HOST=192.168.0.10:631
PRINTER_QUEUE=nome-da-fila-no-cups
# Caminho do socket local do cupsd, usado só quando CUPS_HOST está vazio. O
# padrão já é este; a linha existe pra caso do seu cupsd escutar em outro
# lugar. Tem que casar com o que o compose monta no container (veja o
# docker-compose.snippet.yml: monta a PASTA /run/cups, não o arquivo).
#CUPS_SOCKET=/run/cups/cups.sock
# Opções do lp, com os nomes do PPD da fila em uso (`lpoptions -p FILA -l`).
# Opção com nome errado é ignorada em silêncio, então confira antes de mudar.
# NÃO tire print-scaling=none (senão encolhe ~4%) nem troque A4 por
# A4.Borderless (sem margem a impressora AMPLIA 2-3% pra sangrar).
# MediaType da EPSON L4260: Stationery Photographic PhotographicGlossy
#   PhotographicHighGloss PhotographicSemiGloss PhotographicMatte
LP_OPTIONS=print-scaling=none PageSize=A4 MediaType=PhotographicGlossy cupsPrintQuality=High ColorModel=RGB
# Segundos que o `lp` pode demorar antes de o backend desistir do envio.
PRINT_TIMEOUT_SECONDS=60

# --- Aviso de tinta baixa (pastilha no cabeçalho da página) ---
# O nível vem do CUPS por IPP, e nem toda impressora informa: a de tanque (a
# L4260 é uma) não tem como medir e costuma responder "não sei". Quando
# ninguém sabe, a pastilha simplesmente não aparece. Confira a sua em
# `GET /admin/tinta` (campo `informa_nivel`).
# Vazio = automático. "baixo" liga o aviso de que a produção pode levar 1 a 2
# semanas mesmo se a impressora disser que está cheia; "ok" cala o aviso.
# É a saída de quem enche o tanque no olho — e a única parte disto que não se
# corrige sozinha depois de reabastecer.
TINTA_ESTADO=
# % abaixo do qual a tinta conta como baixa. Só vale quando a impressora não
# informa o limite dela (`marker-low-levels`).
TINTA_LIMITE=20
# Por quanto tempo a resposta vale (24 h). A rota é pública: sem cache, cada
# visita na página vira uma pergunta nova pra impressora — e o nível anda no
# ritmo de quem imprime, não das visitas. É cache em memória: reiniciar o
# container zera na hora, que é o passo depois de reabastecer.
TINTA_CACHE_SEGUNDOS=86400
# Curto de propósito: isto roda durante o carregamento da página, e
# impressora dormindo não pode segurar ninguém.
TINTA_TIMEOUT_SEGUNDOS=4

# Qualidade do JPEG dentro do PDF (95 com 4:4:4 é o padrão, bom pra papel
# fotográfico). Baixar pra 85 corta o tamanho quase pela metade.
JPEG_QUALITY=95

# Reamostra as artes pra este DPI antes de entrar no PDF. As artes do MPC Fill
# dão ~1200 DPI em 63 mm depois de tirada a sangria, umas 4x mais do que jato
# de tinta resolve — os outros 3/4 só engordam o arquivo. Ligado em 600 de
# propósito: medido com artes reais, são 3,6 MB por carta em resolução
# original contra 1,1 MB em 600, ou seja, a diferença entre um PDF de ~200 MB
# e um de ~60 MB subindo pelo link de casa, com o papel idêntico.
# 0 = desligado, mantém a resolução original do Drive.
PRINT_DPI=600

# --- Sangria (bleed) do MPC Fill ---
# A arte do MPC Fill vem no gabarito da MakePlayingCards, 2,72x3,70 pol, que
# tem 3,05 mm de sangria em cada borda; a carta é o miolo de 63x88 mm. O PDF
# recorta essa sangria de cada imagem — sem isso a carta sai com 57,5x82,4 mm
# e ainda espremida. Imagem que já vem na proporção da carta passa intacta.
# CROP_BLEED=0 desliga o recorte (só serve pra comparar impressões).
CROP_BLEED=1
# Quanto a proporção da imagem pode fugir do gabarito e ainda ser tratada
# como gabarito. Não mexa sem necessidade.
BLEED_RATIO_TOL=0.01

# --- Download das imagens do Google Drive ---
# ATENÇÃO: DRIVE_READ_TIMEOUT conta por trecho recebido, não pelo download
# inteiro — é detector de conexão MORTA, não orçamento de lentidão. Se der
# timeout, AUMENTAR não resolve: a rede da máquina travou (rode diag_rede.py).
DRIVE_CONNECT_TIMEOUT=15
DRIVE_READ_TIMEOUT=60
# Teto de tempo por imagem somando todas as tentativas.
DRIVE_TOTAL_TIMEOUT=180
# Tentativas por imagem e a espera inicial entre elas (dobra a cada erro).
DRIVE_RETRIES=4
DRIVE_BACKOFF=2
# Quantas imagens baixam ao mesmo tempo. Se o Drive começar a devolver 429,
# baixe pra 2 em vez de subir.
DRIVE_WORKERS=4

# --- Como o backend se identifica em site de fora ---
# Primeira parte do User-Agent das consultas de preço; o contato sai do
# SMTP_USER (ou do NOTIFY_TO). Ver app/identidade.py.
FORJA_PROJETO=ForjaDeProxies/1.0

# --- Assina o link "Imprimir" do e-mail e libera as rotas /admin ---
ADMIN_TOKEN=escolha-uma-senha-longa-aleatoria

# --- Banco de dados dos pedidos ---
DB_PATH=/app/data/orders.db
PDF_OUTPUT_DIR=/app/data

# --- Limpeza automática dos PDFs antigos ---
# Dias que um PDF fica no disco depois de gerado. 0 desliga a limpeza.
# Apagar é seguro: o XML continua no banco, e abrir "Ver PDF" ou "Imprimir"
# de um pedido antigo remonta a folha (só baixa as imagens do Drive de novo).
PDF_KEEP_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# =========================================================================
# Cotação de preços das cartas (botão "Cotar preços das cartas" na tela)
# =========================================================================
# Isto é outra conta que a da impressão: é quanto custaria COMPRAR as cartas.
# Só roda quando o cliente clica no botão — subir o XML não dispara nada.

# --- LigaMagic ---
# LEIA O AVISO NO TOPO DE app/ligamagic.py ANTES DE MEXER AQUI.
# A LigaMagic não tem API. O robots.txt deles pede Crawl-delay: 360 (seis
# minutos entre requisições) e o preço vem ofuscado em sprite de CSS. O valor
# abaixo é uma divergência CONSCIENTE do que o site pede, não descuido.
# Subir esse número é ir na direção do que eles pedem; descer é ir contra.
COTACAO_LIGAMAGIC=1
LIGAMAGIC_DELAY_SEGUNDOS=3
# O User-Agent de toda requisição já sai montado com o SMTP_USER (ou, na
# falta dele, o NOTIFY_TO) lá de cima como contato — não precisa repetir o
# e-mail aqui. Descomente só se quiser mandar um cabeçalho totalmente seu.
#LIGAMAGIC_USER_AGENT=SeuProjeto/1.0 (cotador de deck; contato: voce@exemplo.com)
# Cartas em paralelo. Não adianta subir: o intervalo acima é global.
LIGAMAGIC_WORKERS=2
LIGAMAGIC_TIMEOUT_CONEXAO=10
LIGAMAGIC_TIMEOUT_LEITURA=30
# Tentativas por requisição. Um 429 aqui segura TODAS as threads da fonte de
# uma vez (ver app/ritmo.py), então insistir não vira rajada nova.
LIGAMAGIC_TENTATIVAS=4
LIGAMAGIC_BACKOFF=2

# --- Scryfall (segunda fonte, pra comparar) ---
# API oficial e documentada, sem trava nenhuma. Mas os preços são do mercado
# americano (TCGplayer), em dólar — NÃO é o custo de comprar no Brasil.
COTACAO_SCRYFALL=1
# Mesma história do LIGAMAGIC_USER_AGENT: sai montado sozinho a partir do
# SMTP_USER/NOTIFY_TO. Descomente só pra sobrescrever.
#SCRYFALL_USER_AGENT=SeuProjeto/1.0 (cotador de deck; contato: voce@exemplo.com)
# Eles pedem 50-100 ms entre requisições. Respeite: é API pública de graça.
# 0,25 e não 0,12 porque na prática eles cortam antes do que documentam: a
# 0,12 (~8 req/s) o 429 chega depois de ~20 requisições e vem com
# Retry-After: 60, ou seja, um minuto parado no meio da cotação. Foi a causa
# de blocos inteiros de carta voltarem sem preço.
SCRYFALL_DELAY_SEGUNDOS=0.25
SCRYFALL_TIMEOUT=15
SCRYFALL_TENTATIVAS=5
SCRYFALL_BACKOFF=1
# Cartas em paralelo. Igual à Liga: o intervalo acima é global, então subir
# isto não acelera — só engorda a rajada que provoca o 429.
SCRYFALL_WORKERS=2
SCRYFALL_MAX_PAGINAS=3
# --- Busca em lote ---
# O `<query>` do MPC Fill é quase o nome exato, e o /cards/collection da
# Scryfall aceita 75 nomes por requisição ignorando caixa, vírgula, hífen e
# apóstrofo. Com isso um deck de 75 cartas sai em ~13 requisições em vez de
# ~150, e o 429 deixa de aparecer. Estes dois raramente precisam mudar.
# Tamanho máximo do filtro `!"A" or !"B" or ...` das edições, em caracteres.
SCRYFALL_MAX_CHARS_BUSCA=900
# Teto de páginas por lote de edições (175 impressões cada). Trava de
# segurança contra laço infinito, não limite prático.
SCRYFALL_MAX_PAGINAS_LOTE=40
# Taxa fixa pra mostrar a coluna da Scryfall em real, só pra facilitar a
# leitura lado a lado. 0 = mostra em dólar mesmo. Não busca câmbio em lugar
# nenhum, e não inclui imposto, frete nem IOF — é ilustrativo.
USD_BRL=0

# --- Câmbio do indicador de carta cara (dólar -> real) ---
# NÃO converte preço nenhum na tela: serve só pra marcar com um ▲ a carta
# que está mais de 20% acima do preço do mercado em dólar. Por isso pode
# errar um pouco sem estragar nada.
# 1 = consulta a AwesomeAPI (público, sem chave) uma vez a cada CAMBIO_TTL;
# 0 = usa direto a taxa fixa abaixo, sem tocar na rede.
CAMBIO_BUSCAR=1
# Taxa usada quando a busca está desligada ou falha. Indicador com dólar a
# R$ 5 é melhor que indicador nenhum.
CAMBIO_USD_BRL=5
CAMBIO_URL=https://economia.awesomeapi.com.br/json/last/USD-BRL
# Seis horas. Câmbio de ontem não muda quem é "muito mais caro no Brasil".
CAMBIO_TTL=21600
# Curto: se o câmbio demorar, o certo é desistir e usar a fixa, não segurar
# a cotação por causa de um enfeite.
CAMBIO_TIMEOUT=4

# --- Cache das ofertas, compartilhado pelas duas fontes ---
# Guardado por CARTA, não por deck: trocar uma carta da lista não joga fora o
# trabalho das outras, e dois decks parecidos aproveitam um o cache do outro.
# Cada acerto aqui é um acesso a menos na LigaMagic.
COTACAO_CACHE_DIR=/app/data/cotacao-cache
COTACAO_CACHE_TTL=43200

# --- Regras da cotação ---
# Teto de cartas distintas POR COTAR, já sem básicas e comandante (um
# Commander tem 99, dos quais ~35 são terreno básico).
COTACAO_MAX_CARTAS=200
# Condições aceitas. Fora daqui ficam HP (muito usada) e D (danificada), que
# são as mais baratas e justamente as que ninguém quer num deck.
COTACAO_CONDICOES=M,NM,SP,MP
# Troca o <query> do MPC Fill pelo nome real da carta antes de perguntar
# preço, usando o /cards/collection da Scryfall como dicionário. Vale pras
# DUAS fontes e é independente de COTACAO_SCRYFALL: a busca da LigaMagic é
# por nome EXATO, então "natures lore" devolve 0 oferta e "Nature's Lore"
# devolve 245. Sem isto, toda carta com vírgula, apóstrofo, hífen, "!" ou
# artigo no nome some da coluna da Liga em silêncio.
COTACAO_RESOLVER_NOMES=1


# =========================================================================
# LOGS
# =========================================================================
# Duas saídas: o stdout (que é o `docker logs`) e arquivos rotativos em
# LOG_DIR. Se LOG_DIR não puder ser criado, fica só o stdout — log que não
# grava não derruba o backend.
#
# Dois arquivos: forja.log com tudo e visitas.log só com quem chegou. As
# visitas são muitas e repetitivas; misturadas, afogariam o log de erro.
#
# LOG_DIR fica DENTRO de /app/data de propósito: é o volume que sobrevive ao
# restart do container. Log que some no deploy não serve pra investigar nada.
LOG_DIR=/app/data/logs
# DEBUG mostra também cada requisição HTTP e cada acerto de cache — útil pra
# caçar problema, barulhento demais pro dia a dia.
LOG_NIVEL=INFO
LOG_MAX_MB=20
LOG_BACKUPS=5

# --- Visitas ---
# Mesmo IP + mesmo User-Agent dentro desta janela são a MESMA visita: uma
# pessoa abrindo a página gera dezenas de requisições, e contar requisição
# faria uma pessoa parecer uma multidão.
VISITA_JANELA_MINUTOS=30
# 1 corta o último octeto do IP (189.4.22.x). Mantém a noção de "é o mesmo
# visitante" e perde a identificação individual.
VISITA_ANONIMIZAR_IP=0
